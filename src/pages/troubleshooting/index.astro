---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TroubleshootingAssistant from '../../components/TroubleshootingAssistant.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema, buildCollectionSchema } from '../../utils/site';

const troubleGuides = await getCollection('troubleshooting', ({ data }) => !data.draft);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '网络故障排查中心', url: '/troubleshooting/' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildCollectionSchema({
    title: '网络故障排查中心｜智能排障助手与10步诊断百科',
    description: '解决机场官网打不开、节点连接失败与超时、订阅链接失效、速度慢、频繁断线、DNS污染及显示连接无法上网问题。',
    url: '/troubleshooting/',
  }),
];
---

<BaseLayout
  title="网络故障排查中心｜连接失败、节点超时、订阅失效与DNS排障指南"
  description="梯子大全网络排障中心：提供11项症状智能故障导航助手，按标准化10步结构解决官网打不开、节点超时、订阅失效、频繁断线、DNS异常及Clash故障。"
  canonicalPath="/troubleshooting/"
  schemas={schemas}
>
  <section class="bg-zone-safety border-b border-slate-200/80 py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div>
        <nav aria-label="面包屑导航" class="text-xs sm:text-sm text-slate-500 mb-3">
          <a href="/" class="hover:text-blue-600">首页</a> / <span class="font-semibold text-slate-800">网络故障排查中心</span>
        </nav>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900">网络故障排查中心</h1>
        <p class="mt-3 text-sm sm:text-base text-slate-700 max-w-3xl leading-relaxed">
          所有排障专题均按统一的“表现 -> 成因 -> 本地/服务端区分 -> 安全基础检查 -> 系统与账户核查 -> 何时联系客服”十步流程编写。绝不提供来源不明的一键修复脚本，也不要求随意关闭防火墙或证书校验。
        </p>
      </div>

      <TroubleshootingAssistant />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 space-y-8">
    <h2 class="text-2xl font-extrabold text-slate-900">全部网络排障深度专题（{troubleGuides.length} 篇）</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {troubleGuides.map((g) => {
        const slug = g.data.slug || g.id.replace(/\.md$/, '');
        return (
          <a href={`/troubleshooting/${slug}/`} class="bento-card p-5 flex flex-col justify-between gap-3 group">
            <div>
              <span class="rounded-md bg-violet-50 border border-violet-200 text-violet-700 px-2.5 py-0.5 text-xs font-bold">{g.data.primaryKeyword}</span>
              <h3 class="mt-2.5 text-base font-extrabold text-slate-900 group-hover:text-blue-600 leading-snug">{g.data.title}</h3>
              <p class="mt-1.5 text-xs text-slate-600 line-clamp-3 leading-relaxed">{g.data.description}</p>
            </div>
            <span class="text-xs font-bold text-violet-700 pt-2 border-t border-slate-100">按10步流程排查 →</span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
