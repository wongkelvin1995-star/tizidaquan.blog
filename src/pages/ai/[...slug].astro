---
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('ai', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = (entry.data.slug || entry.id.replace(/\.md$/, '')).replace(/^\/+|\/+$/g, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);

const relatedLinks = [
  { title: 'AI 工具网络知识中心', href: '/ai/', tag: 'AI专区' },
  { title: 'AI 解锁节点怎么选', href: '/ai/node-selection/', tag: '选区策略' },
  { title: 'ChatGPT 与 OpenAI 访问排查', href: '/ai/chatgpt/access-errors/', tag: '故障排查' },
  { title: '智能网络故障排查助手', href: '/troubleshooting/', tag: '排障工具' },
];
---

<KnowledgeLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: 'AI知识', url: '/ai/' },
    { name: entry.data.platform || entry.data.primaryKeyword, url: `/ai/${slug}/` },
  ]}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  documentedVersion={entry.data.documentedVersion}
  author={entry.data.author}
  headings={headings}
  faqs={entry.data.faqs}
  howToSteps={entry.data.howToSteps}
  relatedBrands={entry.data.relatedBrands}
  relatedLinks={relatedLinks}
  sources={entry.data.sources}
  indexable={entry.data.indexable}
  canonicalPath={`/ai/${slug}/`}
>
  <Content />
</KnowledgeLayout>
