---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceAssistant from '../../components/DeviceAssistant.astro';
import devicesData from '../../data/device-compatibility.json';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema, buildCollectionSchema } from '../../utils/site';

const deviceGuides = await getCollection('devices', ({ data }) => !data.draft);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '设备与操作系统教程中心', url: '/devices/' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildCollectionSchema({
    title: '设备与操作系统使用教程中心（15 类终端完整兼容指南）',
    description: '涵盖Windows 11/10/7、macOS、iPhone、iPad、安卓、OPPO、小米、华为、Linux、路由器、OpenWrt、Chrome与Edge的官方资料配置指南与系统限制说明。',
    url: '/devices/',
    items: devicesData.map((d) => ({ name: d.name, url: d.url })),
  }),
];
---

<BaseLayout
  title="设备与操作系统教程中心｜Windows、Mac、手机、路由器配置百科"
  description="梯子大全设备使用教程中心：覆盖Windows 11/10/7、macOS、iPhone小火箭、安卓Clash、OPPO、小米、华为鸿蒙、Linux、OpenWrt软路由与浏览器代理设置。"
  canonicalPath="/devices/"
  schemas={schemas}
>
  <section class="bg-zone-devices border-b border-slate-200/80 py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div>
        <nav aria-label="面包屑导航" class="text-xs sm:text-sm text-slate-500 mb-3">
          <a href="/" class="hover:text-blue-600">首页</a> / <span class="font-semibold text-slate-800">设备教程中心</span>
        </nav>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900">设备与操作系统教程中心</h1>
        <p class="mt-3 text-sm sm:text-base text-slate-700 max-w-3xl leading-relaxed">
          作为本站第一核心知识集群，本中心严格依据当前系统生命周期（如 Windows 7 已停止安全支持、HarmonyOS 3/4 与 HarmonyOS NEXT 的运行环境差异）与 18 家品牌官方客户端政策，帮您快速定位对应设备的合规安装步骤与兼容限制。
        </p>
      </div>

      <DeviceAssistant />
    </div>
  </section>

  <!-- Bento Grid of all 15 Device Categories -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h2 class="text-2xl font-extrabold text-slate-900">15 类设备与浏览器分类卡片 (Bento Grid)</h2>
      <p class="text-sm text-slate-600 mt-1">每张卡片均标注实际支持边界与最低系统基线，点击进入完整深度教程。</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {devicesData.map((dev) => (
        <article class="bento-card p-6 flex flex-col justify-between gap-4">
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-lg bg-cyan-50 border border-cyan-200 px-2.5 py-0.5 text-xs font-bold text-cyan-800">
                {dev.categoryLabel} · {dev.osFamily}
              </span>
              <span class="text-xs text-slate-400">独立专题</span>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900">
              <a href={dev.url} class="hover:text-blue-600 transition-colors">{dev.name}</a>
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">{dev.supportSummary}</p>
            <div class="text-xs text-slate-700">
              <strong>系统基线：</strong>{dev.minRequirement}
            </div>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {dev.clientOptions.map((opt) => (
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700">{opt}</span>
              ))}
            </div>
            <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200/80 rounded-xl p-2.5 leading-relaxed">
              {dev.caution}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
            <a href={dev.url} class="btn-primary text-xs w-full text-center">
              阅读 {dev.name} 完整教程 →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- All 19 Guides Quick Index -->
    <div class="mt-12 bento-card p-6 sm:p-8">
      <h2 class="text-xl font-extrabold text-slate-900 mb-4">全部设备与专项指南目录（共 {deviceGuides.length} 篇）</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {deviceGuides.map((g) => {
          const slug = g.data.slug || g.id.replace(/\.md$/, '');
          return (
            <a href={`/devices/${slug}/`} class="rounded-xl border border-slate-200 p-3.5 hover:border-blue-400 hover:bg-blue-50/40 transition-colors">
              <div class="text-xs font-bold text-cyan-700">{g.data.platform || g.data.device}</div>
              <div class="text-sm font-extrabold text-slate-900 mt-0.5">{g.data.title}</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
