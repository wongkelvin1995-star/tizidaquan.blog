---
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('beginners', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = (entry.data.slug || entry.id.replace(/\.md$/, '')).replace(/^\/+|\/+$/g, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);

const relatedLinks = [
  { title: '新手入门六阶段手册与术语词典', href: '/beginners/', tag: '新手总览' },
  { title: '第一次买机场怎么选', href: '/beginners/choosing-service/', tag: '购买决策' },
  { title: '设备与操作系统教程中心', href: '/devices/', tag: '设备教程' },
  { title: '官网真假识别与防骗指南', href: '/safety/website-verification/', tag: '安全防骗' },
];
---

<KnowledgeLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '新手百科', url: '/beginners/' },
    { name: entry.data.primaryKeyword, url: `/beginners/${slug}/` },
  ]}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  documentedVersion={entry.data.documentedVersion}
  author={entry.data.author}
  headings={headings}
  faqs={entry.data.faqs}
  howToSteps={entry.data.howToSteps}
  relatedBrands={entry.data.relatedBrands}
  relatedLinks={relatedLinks}
  sources={entry.data.sources}
  indexable={entry.data.indexable}
  canonicalPath={`/beginners/${slug}/`}
>
  <Content />
</KnowledgeLayout>
