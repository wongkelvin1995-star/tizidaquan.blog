---
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('streaming', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = (entry.data.slug || entry.id.replace(/\.md$/, '')).replace(/^\/+|\/+$/g, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);

const relatedLinks = [
  { title: '流媒体网络知识中心', href: '/streaming/', tag: '流媒体专区' },
  { title: '机场流量消耗估算表', href: '/beginners/traffic-calculation/', tag: '流量预算' },
  { title: 'Netflix 状态合法自查指南', href: '/streaming/netflix/status-check/', tag: '状态检查' },
  { title: 'YouTube 卡顿统计排查', href: '/streaming/youtube/buffering/', tag: '播放排障' },
];
---

<KnowledgeLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '流媒体知识', url: '/streaming/' },
    { name: entry.data.platform || entry.data.primaryKeyword, url: `/streaming/${slug}/` },
  ]}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  documentedVersion={entry.data.documentedVersion}
  author={entry.data.author}
  headings={headings}
  faqs={entry.data.faqs}
  howToSteps={entry.data.howToSteps}
  relatedBrands={entry.data.relatedBrands}
  relatedLinks={relatedLinks}
  sources={entry.data.sources}
  indexable={entry.data.indexable}
  canonicalPath={`/streaming/${slug}/`}
>
  <Content />
</KnowledgeLayout>
