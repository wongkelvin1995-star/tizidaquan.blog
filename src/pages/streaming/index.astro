---
import BaseLayout from '../../layouts/BaseLayout.astro';
import brandsData from '../../data/brands.json';
import scenariosData from '../../data/service-scenarios.json';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema, buildCollectionSchema } from '../../utils/site';

const streamGuides = await getCollection('streaming', ({ data }) => !data.draft);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '流媒体网络知识中心', url: '/streaming/' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildCollectionSchema({
    title: '流媒体网络使用知识中心｜Netflix、YouTube、Disney+、TikTok 专题',
    description: '讲解流媒体平台版权区域限制、4K带宽与流量估算、合法官方自查方法及18家品牌流媒体公开覆盖记录。',
    url: '/streaming/',
  }),
];
---

<BaseLayout
  title="流媒体网络知识中心｜Netflix、YouTube、Disney+、TikTok使用与自查"
  description="提供Netflix、YouTube、Disney+与TikTok国际版网络知识：包含合法官方解锁状态自查、YouTube卡顿排查、Disney+区域对比与直播网络条件说明。"
  canonicalPath="/streaming/"
  schemas={schemas}
>
  <section class="bg-zone-streaming border-b border-slate-200/80 py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="面包屑导航" class="text-xs sm:text-sm text-slate-500 mb-3">
        <a href="/" class="hover:text-blue-600">首页</a> / <span class="font-semibold text-slate-800">流媒体网络知识</span>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900">流媒体网络使用知识中心</h1>
      <p class="mt-3 text-sm sm:text-base text-slate-700 max-w-3xl leading-relaxed">
        观看海外正版流媒体需遵守各自平台的用户条款与订阅规定。本中心客观解释区域版权限制、视频码率对应的月流量消耗，并只依据 18 家品牌的真实资料展示适配标签（任何服务商均不作永久解锁保证）。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 space-y-10">
    <!-- Platform Cards -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      {scenariosData.streaming.map((st) => (
        <article class="bento-card p-6 flex flex-col justify-between gap-4">
          <div class="space-y-3">
            <h2 class="text-xl font-extrabold text-slate-900">{st.name}</h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{st.officialPolicySummary}</p>
            <ul class="list-disc pl-4 text-xs text-slate-700 space-y-1">
              {st.commonIssues.map((iss) => (
                <li>{iss}</li>
              ))}
            </ul>
            <p class="text-xs text-rose-900 bg-rose-50 border border-rose-200 rounded-xl p-2.5 leading-relaxed">
              <strong>核查方法：</strong>{st.checkMethod}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
            <a href={st.url} class="btn-primary text-xs text-center">{st.name} 指南与品牌清单 →</a>
            <a href={st.subUrl} class="btn-secondary text-xs text-center">专项排障 / 地区选择 →</a>
          </div>
        </article>
      ))}
    </div>

    <!-- Brand Streaming Filter -->
    <div class="bento-card p-6 sm:p-8 space-y-5">
      <div>
        <h2 class="text-xl font-extrabold text-slate-900">按真实品牌资料筛选流媒体覆盖记录</h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">仅列出原始品牌资料中有明确文字记录的平台标签；TikTok 需注意避开香港节点并确认设备环境条件。</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {[
            { id: 'all', label: '全部品牌' },
            { id: 'Netflix', label: '提及 Netflix' },
            { id: 'Disney+', label: '提及 Disney+' },
            { id: 'YouTube', label: '提及 YouTube' },
            { id: 'TikTok', label: '提及 TikTok' },
          ].map((btn, i) => (
            <button
              type="button"
              data-st-filter={btn.id}
              class:list={[
                'st-f-btn min-h-[40px] px-3.5 py-1.5 rounded-xl border text-xs font-bold cursor-pointer transition-colors',
                i === 0 ? 'bg-rose-600 text-white border-rose-600' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-rose-400',
              ]}
            >
              {btn.label}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {brandsData.map((b) => (
          <a
            href={`/brands/${b.slug}/`}
            data-st-list={b.streaming.join('|')}
            class="st-brand-item rounded-2xl border border-slate-200 p-4 hover:border-rose-300 hover:bg-rose-50/30 transition-colors"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-extrabold text-slate-900 text-sm">{b.name}</span>
              <span class="text-[11px] font-semibold text-slate-500">{b.regions.length} 个地区</span>
            </div>
            <div class="mt-2 flex flex-wrap gap-1">
              {b.streaming.map((s: string) => (
                <span class="rounded bg-rose-50 border border-rose-200 px-2 py-0.5 text-[11px] font-bold text-rose-800">{s}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- All 10 Streaming Guides -->
    <div class="bento-card p-6 sm:p-8">
      <h2 class="text-xl font-extrabold text-slate-900 mb-4">流媒体网络专题全集（{streamGuides.length} 篇）</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {streamGuides.map((g) => {
          const slug = g.data.slug || g.id.replace(/\.md$/, '');
          return (
            <a href={`/streaming/${slug}/`} class="rounded-xl border border-slate-200 p-4 hover:border-rose-300 hover:bg-rose-50/20 transition-colors">
              <div class="text-xs font-bold text-rose-700">{g.data.platform}</div>
              <div class="text-sm font-extrabold text-slate-900 mt-1">{g.data.title}</div>
              <p class="text-xs text-slate-600 mt-1 line-clamp-2">{g.data.description}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const btns = document.querySelectorAll('.st-f-btn');
    const items = document.querySelectorAll('.st-brand-item');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-st-filter');
        btns.forEach((b) => {
          const active = b.getAttribute('data-st-filter') === key;
          b.className = `st-f-btn min-h-[40px] px-3.5 py-1.5 rounded-xl border text-xs font-bold cursor-pointer transition-colors ${
            active ? 'bg-rose-600 text-white border-rose-600' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-rose-400'
          }`;
        });
        items.forEach((el) => {
          const list = (el.getAttribute('data-st-list') || '').toLowerCase();
          const show = key === 'all' ? list.length > 0 : list.includes(key.toLowerCase());
          el.classList.toggle('hidden', !show);
        });
      });
    });
  })();
</script>
