---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
}

const { faqs = [], title = '常见问题解答 (FAQ)' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="mt-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl font-extrabold text-slate-900 mb-4">{title}</h2>
    <div class="space-y-3">
      {faqs.map((item, index) => (
        <details class="group bento-card overflow-hidden" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-bold text-slate-900 hover:bg-slate-50/70 transition-colors min-h-[48px]">
            <span>{item.q}</span>
            <svg
              class="w-5 h-5 shrink-0 text-slate-500 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="px-5 pb-4 pt-1 text-sm sm:text-base text-slate-700 leading-relaxed border-t border-slate-100">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
