---
import { TOP_NAV } from '../utils/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 glass-nav">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xl">
      <img src="/logo.svg" alt="梯子大全 Ladder Encyclopedia" width="196" height="42" class="h-9 w-auto sm:h-10" />
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="主导航" class="hidden lg:flex items-center gap-1">
      {TOP_NAV.filter((item) => item.href !== '/search/').map((item) => {
        const active =
          item.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(item.href) ||
              (item.href === '/ai/' && currentPath.startsWith('/streaming/')) ||
              (item.href === '/safety/' && currentPath.startsWith('/troubleshooting/'));
        return (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-xl text-sm font-semibold transition-colors whitespace-nowrap',
              active ? 'bg-blue-50 text-blue-700' : 'text-slate-700 hover:bg-slate-100 hover:text-slate-950',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Actions: Search & Mobile Drawer -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="open-search-btn"
        aria-label="打开全站中文搜索"
        class="inline-flex items-center gap-2 min-h-[44px] px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-blue-400 hover:text-blue-700 transition-colors text-sm font-medium shadow-2xs cursor-pointer"
      >
        <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
        </svg>
        <span class="hidden sm:inline">搜索百科</span>
        <kbd class="hidden xl:inline-block rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-mono text-slate-500 border border-slate-200">/</kbd>
      </button>

      <a
        href="/search/"
        class="hidden md:inline-flex lg:hidden items-center min-h-[44px] px-3 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100"
      >
        搜索
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="hidden lg:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md">
    <nav aria-label="移动端主导航" class="mx-auto max-w-7xl px-4 py-4 grid grid-cols-2 gap-2">
      {TOP_NAV.map((item) => {
        const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'flex items-center min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-semibold border transition-colors',
              active
                ? 'bg-blue-50 border-blue-200 text-blue-700'
                : 'bg-slate-50/70 border-slate-200 text-slate-800 hover:bg-blue-50/60',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/streaming/"
        class="flex items-center min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-semibold border bg-slate-50/70 border-slate-200 text-slate-800 hover:bg-blue-50/60"
      >
        流媒体知识
      </a>
      <a
        href="/troubleshooting/"
        class="flex items-center min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-semibold border bg-slate-50/70 border-slate-200 text-slate-800 hover:bg-blue-50/60"
      >
        网络排障中心
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (toggle && drawer) {
      toggle.addEventListener('click', () => {
        const isHidden = drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
    }
  })();
</script>
