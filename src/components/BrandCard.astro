---
interface Props {
  brand: any;
  compact?: boolean;
}

const { brand, compact = false } = Astro.props;
---

<article class="bento-card p-5 sm:p-6 flex flex-col justify-between gap-4 h-full">
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-2">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-xs font-bold text-blue-700">
          {brand.badge}
        </span>
        <h3 class="mt-2 text-lg font-extrabold text-slate-900 leading-snug">
          <a href={`/brands/${brand.slug}/`} class="hover:text-blue-600 transition-colors">
            {brand.name}
            {brand.nameEn && <span class="ml-1.5 text-sm font-semibold text-slate-500">({brand.nameEn})</span>}
          </a>
        </h3>
      </div>
      {brand.minFirstPurchase && (
        <div class="text-right shrink-0">
          <div class="text-[11px] font-medium text-slate-500">历史起步</div>
          <div class="text-base font-extrabold text-blue-700">¥{brand.minFirstPurchase}</div>
        </div>
      )}
    </div>

    <p class="text-sm text-slate-600 leading-relaxed">{brand.tagline}</p>

    <div class="flex flex-wrap gap-1.5">
      <span
        class:list={[
          'inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-semibold border',
          brand.clientFlags?.thirdPartyMode === 'supported'
            ? 'bg-emerald-50 border-emerald-200 text-emerald-700'
            : brand.clientFlags?.thirdPartyMode === 'conditional'
              ? 'bg-amber-50 border-amber-200 text-amber-800'
              : 'bg-slate-100 border-slate-200 text-slate-700',
        ]}
      >
        {brand.clientFlags?.thirdPartyLabel}
      </span>
      {brand.regions?.slice(0, 4).map((r: string) => (
        <span class="inline-flex items-center rounded-lg bg-slate-50 border border-slate-200 px-2 py-1 text-xs text-slate-700">
          {r}
        </span>
      ))}
      {brand.regions?.length > 4 && (
        <span class="inline-flex items-center rounded-lg bg-slate-50 border border-slate-200 px-2 py-1 text-xs text-slate-500">
          +{brand.regions.length - 4} 地区
        </span>
      )}
    </div>

    {!compact && (
      <div class="pt-2 border-t border-slate-100 space-y-1.5 text-xs text-slate-600">
        {brand.supportedPlatforms && (
          <div><strong class="text-slate-800">支持系统：</strong>{brand.supportedPlatforms.slice(0, 4).join(' / ')}</div>
        )}
        {brand.deviceLimit && (
          <div><strong class="text-slate-800">设备限制：</strong>{brand.deviceLimit}</div>
        )}
        {brand.aiTools?.length > 0 && (
          <div><strong class="text-slate-800">资料提及 AI：</strong>{brand.aiTools.join('、')}</div>
        )}
      </div>
    )}
  </div>

  <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
    <div class="text-[11px] text-slate-500">
      记录：{brand.historyPriceDate}
    </div>
    <div class="flex items-center gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold transition-colors"
      >
        查看完整档案
      </a>
      <a
        href={brand.affiliateUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-blue-700 text-white text-xs font-bold transition-colors"
      >
        官网入口
      </a>
    </div>
  </div>
</article>
