---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE, absUrl } from '../utils/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  indexable?: boolean;
  ogType?: 'website' | 'article';
  publishDate?: string;
  updatedDate?: string;
  schemas?: Array<Record<string, unknown> | null>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  indexable = true,
  ogType = 'website',
  publishDate,
  updatedDate,
  schemas = [],
} = Astro.props;

const canonicalUrl = absUrl(canonicalPath);
const ogImage = `${SITE.url}/og-cover.svg`;
const validSchemas = schemas.filter(Boolean);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="梯子大全 RSS" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {validSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const targets = document.querySelectorAll('.reveal-section');
        if (!targets.length || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-enhanced');
        const revealAboveOrInView = () => {
          const thresholdY = window.innerHeight * 1.1;
          targets.forEach((el) => {
            if (el.getAttribute('data-reveal') === 'visible') return;
            const rect = el.getBoundingClientRect();
            if (rect.top < thresholdY) {
              el.setAttribute('data-reveal', 'visible');
            }
          });
        };
        targets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          el.setAttribute('data-reveal', rect.top < window.innerHeight * 1.05 ? 'visible' : 'pending');
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                revealAboveOrInView();
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.02, rootMargin: '0px 0px 80px 0px' }
        );
        targets.forEach((el) => {
          if (el.getAttribute('data-reveal') === 'pending') io.observe(el);
        });
        window.addEventListener('scroll', revealAboveOrInView, { passive: true });
      })();
    </script>
  </body>
</html>
