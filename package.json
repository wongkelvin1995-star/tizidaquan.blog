{
  "name": "tizidaquan-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "梯子大全 tizidaquan.blog — Ladder Encyclopedia ULTIMATE MAX · 极境梯子知识百科旗舰：设备使用教程、AI与流媒体知识、新手入门与网络问题排查",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:data": "node scripts/build-data.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "build:search": "node scripts/build-search-index.mjs",
    "prebuild": "node scripts/build-data.mjs && node scripts/generate-content.mjs && node scripts/build-search-index.mjs",
    "build": "astro build && npx pagefind --site dist && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "audit": "node scripts/audit-site.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:submit": "node scripts/indexnow.mjs --submit"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^5.18.2",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "node-html-parser": "^7.0.1",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.3"
  }
}
